#!/bin/sh

awk '
NR == 1 && length($0) > 50 {
    print "Ошибка: первая строка длиннее 50 символов"
    error = 1
}
NR > 1 && length($0) > 72 {
    print "Ошибка: строка " NR " длиннее 72 символов"
    error = 1
}
{
    if (index($0, "\t") > 0) {
        print "Ошибка: табуляция запрещена"
        error = 1
    }
    match($0, /^ */)
    if (RLENGTH % 4 != 0) {
        print "Ошибка: отступ должен быть кратен 4 пробелам"
        error = 1
    }
}
END {
    exit error
}
' "$1"